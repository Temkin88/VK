# Пример инициализации

```python
from pyvkteamsclient.client import DesktopClient


# ICQ
icq = test = DesktopClient(
    uin='753057653',
    phone='+99992020******',
    code='*****',
    api_ver=99,
    env='ICQ',
)

# SANDBOX
sandbox = DesktopClient(
    uin='autotest001@autotest.clients',
    api_url='https://u-vkorobov.v3.im-sandbox.devmail.ru',
    binary_api_url='https://ub-vkorobov.v3.im-sandbox.devmail.ru',
    api_ver=99,
    env='SANDBOX'
)

# VKTI
vkti = DesktopClient(
    uin='myteam-qa48@corp.mail.ru',
    api_url='https://u.internal.myteam.mail.ru',
    binary_api_url='https://ub.internal.myteam.mail.ru',
    api_ver=99,
    env='VKTI',
    email_url='imap.mail.ru',
    email_password='************'
)

# TARM
tarm = DesktopClient(
    uin='myteam-qa48@armgs.team',
    api_url='https://u.armgs.team',
    binary_api_url='https://ub.armgs.team',
    api_ver=99,
    env='TARM',
    email_url='mxs.armgs.team',
    email_password='******'
)
```

# Пример использования

```python
from pyvkteamsclient.client import DesktopClient


test = DesktopClient(
    uin='autotest001@autotest.clients',
    api_url='https://u-vkorobov.v3.im-sandbox.devmail.ru',
    binary_api_url='https://ub-vkorobov.v3.im-sandbox.devmail.ru',
    api_ver=99,
    env='SANDBOX'
)

# Отправка сообщений
test.send_basic_message(
    sn=test.uin,
    text='Test'
)

# Сброс настроек приватности
test.restore_privacy_settings()
```